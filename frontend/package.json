{
  "scripts": {
    "build": "turbo run build --env-mode=loose",
    "build:packages": "turbo run build --env-mode=loose --filter=./packages/*",
    "build:pkgs": "npm run build:packages",
    "clean": "turbo run clean && rm -rf .turbo",
    "dev": "turbo run dev --env-mode=loose",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "docker": "turbo prune @vydon/app --docker",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "knip": "knip",
    "knip:production": "knip --production --strict"
  },
  "devDependencies": {
    "knip": "^5.88.1",
    "prettier": "^3.8.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "next": "^16.2.6"
  },
  "packageManager": "npm@10.9.8",
  "name": "vydon-frontend"
}
